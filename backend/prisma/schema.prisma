generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ARRIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Doctor {
  id         String   @id @default(uuid())
  name       String
  department String
  phone      String?
  photoUrl   String?
  workingHours Json?
  isActive   Boolean  @default(true)
  bookings   HospitalBooking[]
  createdAt  DateTime @default(now())
}

model HospitalBooking {
  id              String        @id @default(uuid())
  fullName        String
  phone           String
  email           String
  department      String
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id])
  preferredDate   DateTime      @db.Date
  preferredTime   String
  notes           String?
  status          BookingStatus @default(PENDING)
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
}

model DiagnosisBooking {
  id              String        @id @default(uuid())
  fullName        String
  phone           String
  email           String
  testType        String
  preferredDate   DateTime      @db.Date
  preferredTime   String
  notes           String?
  status          BookingStatus @default(PENDING)
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
}

model PharmaInquiry {
  id                String        @id @default(uuid())
  companyName       String
  contactPerson     String
  businessEmail     String
  phone             String
  interestArea      String
  estimatedQuantity String?
  message           String
  status            InquiryStatus @default(NEW)
  idempotencyKey    String        @unique
  referenceId       String        @unique
  createdAt         DateTime      @default(now())
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  purpose   String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TestType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model InterestArea {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum BlogPillar {
  HOSPITAL
  DIAGNOSIS
  PHARMA
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String     @id @default(uuid())
  pillar        BlogPillar
  title         String
  slug          String     @unique
  content       String     @db.Text
  coverImageUrl String?
  status        BlogStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
